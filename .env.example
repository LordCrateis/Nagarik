# Server-side only. Never expose these through a VITE_* variable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY2=
GROQ_CHAT_MODEL=groq/compound-mini

# Server-side Gemini Flash key for source-grounded eligibility, conflicts,
# bundles, and explanations. Never expose this as a VITE_* variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite


# Optional ingestion limits.
GROQ_EXTRACTION_LIMIT=0
GROQ_MAX_DOCUMENT_CHARS=45000

# Safe to expose to the browser. Never use a service_role or secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY


